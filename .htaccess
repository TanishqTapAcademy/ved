# ============================================================
#  VedSphere — clean URLs (no .html) for Hostinger / LiteSpeed
#  Real .html files stay on disk (so links work locally too);
#  the server hides the .html extension from the address bar.
# ============================================================

Options -MultiViews -Indexes
DirectoryIndex index.html

# Don't auto-redirect /blogs -> /blogs/ ; we map /blogs to blogs.html ourselves
DirectorySlash Off

RewriteEngine On
RewriteBase /

# 1) index.html  ->  site root "/"
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^ / [R=301,L]

# 2) Strip ".html" from the address bar:  /blogs.html -> /blogs
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# 3) Strip a trailing slash when a matching .html exists:  /blogs/ -> /blogs
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/$ /$1 [R=301,L]

# 4) Internally serve the .html file for the clean URL.
#    (No !-d guard on purpose: this must win over the same-named "blogs/" folder.)
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.+?)/?$ /$1.html [L]

# 5) Optional friendly 404
ErrorDocument 404 /index.html

# ============================================================
#  Performance — gzip compression + browser caching
# ============================================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html              "access plus 0 seconds"
  ExpiresByType text/css               "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/png              "access plus 1 year"
  ExpiresByType image/jpeg             "access plus 1 year"
  ExpiresByType image/webp             "access plus 1 year"
  ExpiresByType image/svg+xml          "access plus 1 year"
  ExpiresByType image/x-icon           "access plus 1 year"
  ExpiresByType font/woff2             "access plus 1 year"
</IfModule>

# ============================================================
#  Basic security headers
# ============================================================
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
