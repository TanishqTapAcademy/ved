# ============================================================
#  VedSphere — Apache config for shared/cPanel hosting
#  Replaces Vercel's "cleanUrls" + "trailingSlash: false"
#  Drop this file in the site root (public_html).
# ============================================================

# Turn off Apache's content negotiation so our rules control routing
Options -MultiViews -Indexes
DirectoryIndex index.html

RewriteEngine On
RewriteBase /

# ------------------------------------------------------------
# 1) Canonical host: force HTTPS + www  (canonical = www.vedsphere.com)
#    If your SSL certificate is NOT installed yet, comment out the
#    two HTTPS lines below until it is, to avoid a broken redirect.
# ------------------------------------------------------------
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
RewriteRule ^ https://www.%1%{REQUEST_URI} [L,R=301]

# ------------------------------------------------------------
# 2) Clean URLs — redirect the old .html address to the
#    extensionless one (e.g. /blogs.html  ->  /blogs)
#    Keeps a single canonical URL and matches what was live on Vercel.
# ------------------------------------------------------------
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# ------------------------------------------------------------
# 3) Trailing slash — strip it when a clean .html target exists
#    (e.g. /blogs/  ->  /blogs).  Real asset folders are untouched.
# ------------------------------------------------------------
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/$ /$1 [R=301,L]

# ------------------------------------------------------------
# 4) Internally serve the matching .html file for a clean URL.
#    This is what makes a hard refresh on /blogs (or any deep
#    link) work instead of 404-ing.  Note: this also wins over the
#    same-named "blogs/" folder, so /blogs serves blogs.html.
# ------------------------------------------------------------
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.+?)/?$ /$1.html [L]

# ------------------------------------------------------------
# 5) Optional: custom 404 (uncomment if you add a 404.html page)
# ------------------------------------------------------------
# ErrorDocument 404 /404.html

# ============================================================
#  Performance — gzip compression + browser caching
# ============================================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html              "access plus 0 seconds"
  ExpiresByType text/css               "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/png              "access plus 1 year"
  ExpiresByType image/jpeg             "access plus 1 year"
  ExpiresByType image/webp             "access plus 1 year"
  ExpiresByType image/svg+xml          "access plus 1 year"
  ExpiresByType image/x-icon           "access plus 1 year"
  ExpiresByType font/woff2             "access plus 1 year"
</IfModule>

# ============================================================
#  Basic security headers
# ============================================================
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
