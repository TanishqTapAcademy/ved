# ============================================================
#  VedSphere — Apache config for Hostinger / cPanel
#  The site uses real .html files, so NO URL rewriting is
#  needed — every page works on its own. This file only adds
#  safe performance + security improvements.
# ============================================================

# Default page for the root URL, and disable directory listing
DirectoryIndex index.html
Options -Indexes

# Friendly 404 -> sends visitors to the homepage
# (optional: create a 404.html page and point to it instead)
ErrorDocument 404 /index.html

# ------------------------------------------------------------
#  OPTIONAL: force https + www (canonical = www.vedsphere.com)
#  Hostinger already has a "Force HTTPS" switch in hPanel, so
#  you usually do NOT need this. Uncomment only if you want www
#  enforced AND your SSL certificate is already active.
# ------------------------------------------------------------
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} off [OR]
#   RewriteCond %{HTTP_HOST} !^www\. [NC]
#   RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
#   RewriteRule ^ https://www.%1%{REQUEST_URI} [L,R=301]
# </IfModule>

# ============================================================
#  Performance — gzip compression + browser caching
# ============================================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html              "access plus 0 seconds"
  ExpiresByType text/css               "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/png              "access plus 1 year"
  ExpiresByType image/jpeg             "access plus 1 year"
  ExpiresByType image/webp             "access plus 1 year"
  ExpiresByType image/svg+xml          "access plus 1 year"
  ExpiresByType image/x-icon           "access plus 1 year"
  ExpiresByType font/woff2             "access plus 1 year"
</IfModule>

# ============================================================
#  Basic security headers
# ============================================================
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
